# World Labs Atlas (Marble 2 beta) Developer API key. Keep this file out of git.
WLT_API_KEY=wl_live_replace_with_your_key
WLT_API_BASE_URL=https://api.atlas-beta.worldlabs.ai/api/v2

# Who may start a world: "local" (only requests from this machine), "open" (any visitor), or "off".
WORLD_GENERATION=local
# "on": opening a book starts its world straight away. "off": the reader presses a button first.
WORLD_AUTOSTART=on
# Hard ceiling on new worlds started per calendar day, and at once.
WORLD_DAILY_LIMIT=20
WORLD_CONCURRENCY=2

# Optional walkable Gaussian-splat version of a world ("Make it walkable"). Off by default.
# WORLD_QUALITY: "draft" (fast pass) or "refined" (10-20 minutes; World Labs lists it at $5 a world).
WORLD_SPLATS=off
WORLD_QUALITY=draft

PORT=8787
